rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. VÙNG BẢO MẬT TỐI MẬT (Chỉ Server / Admin SDK mới có quyền truy cập)
    // Chứa salt, hash mật khẩu scrypt và mã hóa AES-256 hai chiều của Quán
    // Client (Web / iOS / Android) tuyệt đối KHÔNG THỂ đọc hay ghi trực tiếp
    // ==========================================
    match /user_secrets/{userId} {
      allow read, write: if false;
    }

    // Lịch sử giao dịch SePay chống gian lận & Replay Attack (Chỉ Webhook Server ghi)
    match /processed_transactions/{txId} {
      allow read, write: if false;
    }

    // ==========================================
    // 2. CÀI ĐẶT HỆ THỐNG VÀ GÓI CƯỚC (Nền tảng)
    // Cho phép đọc công khai để cả app mới và app cũ (iOS/TestFlight)
    // kết nối kiểm tra phiên bản mà không bị lỗi permission-denied
    // ==========================================
    match /system/{docId} {
      allow read, write: if true;
    }

    match /app_settings/{docId} {
      allow read, write: if true;
    }

    match /packages/{packageId} {
      allow read, write: if true;
    }

    // ==========================================
    // 3. THÔNG TIN QUÁN VÀ TÀI KHOẢN NGƯỜI DÙNG
    // Tương thích cả phương thức đăng nhập qua máy chủ Vercel lẫn đăng nhập ngoại tuyến
    // ==========================================
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.resource.data.code is string;
      allow update, delete: if true;
    }

    match /users/{userId} {
      // Cho phép đọc thông tin tài khoản phục vụ đăng nhập và phân quyền nhân sự
      allow read: if true;

      // Cho phép tạo tài khoản nhân sự với vai trò hợp lệ
      allow create: if request.resource.data.storeId is string
                    && request.resource.data.username is string
                    && request.resource.data.role in ['admin', 'manager', 'cashier', 'order', 'order_cashier', 'kitchen'];

      // Cho phép xóa tài khoản nhân sự
      allow delete: if true;

      // Cho phép cập nhật hồ sơ, bảo lưu tính toàn vẹn của role và storeId
      allow update: if request.resource.data.role == resource.data.role
                    && request.resource.data.storeId == resource.data.storeId
                    && request.resource.data.username == resource.data.username;
    }

    // ==========================================
    // 4. DỮ LIỆU TỔNG HỢP BÁO CÁO (Doanh thu ngày / tháng / năm)
    // ==========================================
    match /daily_stats/{statId} {
      allow read, write: if true;
    }

    // ==========================================
    // 5. DỮ LIỆU VẬN HÀNH BÁN HÀNG CỦA QUÁN
    // (Thực đơn, Bàn, Hóa đơn, Kho hàng, Khách hàng, Sổ quỹ, Ca làm, Chấm công...)
    // Tương thích 100% với các máy iPhone / iPad đang chạy bản cũ trên TestFlight & App Store
    // ==========================================
    match /menu/{menuId} {
      allow read, write: if true;
    }

    match /tables/{tableId} {
      allow read, write: if true;
    }

    match /table_groups/{groupId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /inventory_logs/{logId} {
      allow read, write: if true;
    }

    match /inventory_audits/{auditId} {
      allow read, write: if true;
    }

    match /stock_card/{cardId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /cash_transactions/{txId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /attendance_records/{attId} {
      allow read, write: if true;
    }

    match /payroll_records/{payrollId} {
      allow read, write: if true;
    }

    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    match /cancelled_invoices/{cancelId} {
      allow read, write: if true;
    }

    match /checkout_locks/{lockId} {
      allow read, write: if true;
    }
  }
}
