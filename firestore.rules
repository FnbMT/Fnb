rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. CÁC HÀM TIỆN ÍCH PHÂN QUYỀN (Helpers)
    // Sử dụng .get(tên_trường, mặc_định) theo chuẩn Firebase
    // để tránh lỗi Property undefined khi trường tùy chọn chưa tồn tại
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    // SuperAdmin quản trị toàn bộ nền tảng FNB:
    // BẮT BUỘC phải có custom claims do Firebase Admin SDK chính thức ký
    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.get('isSuperAdmin', false) == true &&
        request.auth.token.get('role', '') == 'superadmin' &&
        request.auth.token.get('storeId', '') == 'superadmin';
    }

    // Kiểm tra người dùng có thuộc cửa hàng này không
    function belongsToStore(storeId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.get('storeId', '') != '' && request.auth.token.get('storeId', '') == storeId)
      );
    }

    // Kiểm tra vai trò quản lý của quán (Admin hoặc Quản lý)
    function isStoreManager() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.get('role', '') in ['admin', 'manager'])
      );
    }

    // Kiểm tra quyền thao tác thu ngân và quản lý (Thu ngân, Thu ngân kiêm gọi món, Quản lý, Chủ quán)
    function isCashierOrManager() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.get('role', '') in ['admin', 'manager', 'cashier', 'order_cashier'])
      );
    }

    // Kiểm tra document đọc/sửa có thuộc storeId của người dùng không (Dữ liệu trước khi ghi)
    function isDocumentOfStore() {
      return isSuperAdmin() || (
        isSignedIn() &&
        request.auth.token.get('storeId', '') != '' &&
        resource.data.get('storeId', '') == request.auth.token.get('storeId', '')
      );
    }

    // Kiểm tra dữ liệu mới tạo có gắn đúng storeId của người dùng không (Dữ liệu sau khi ghi)
    function isWritingDocumentOfStore() {
      return isSuperAdmin() || (
        isSignedIn() &&
        request.auth.token.get('storeId', '') != '' &&
        request.resource.data.get('storeId', '') == request.auth.token.get('storeId', '')
      );
    }

    // Kiểm tra cập nhật an toàn: Document cũ thuộc store VÀ storeId không bị sửa đổi hay chuyển sang quán khác
    function isSafeStoreUpdate() {
      return isSuperAdmin() || (
        isDocumentOfStore() &&
        request.resource.data.get('storeId', '') == resource.data.get('storeId', '')
      );
    }

    // ==========================================
    // 2. VÙNG BẢO MẬT TỐI MẬT (Chỉ Admin SDK trên Server)
    // ==========================================
    // Chứa hash mật khẩu scrypt, salt và mã hóa AES-256
    match /user_secrets/{userId} {
      allow read, write: if false;
    }

    // Lịch sử giao dịch SePay chống gian lận & Replay Attack (Chỉ Webhook Server ghi)
    match /processed_transactions/{txId} {
      allow read, write: if false;
    }

    // ==========================================
    // 3. CÀI ĐẶT HỆ THỐNG VÀ GÓI CƯỚC (Nền tảng)
    // ==========================================
    match /system/{docId} {
      // Tuyệt đối không cho phép đọc hoặc ghi bất kỳ document nào có tên chứa user_secret
      allow read: if !docId.matches('user_secret_.*');
      allow write: if isSuperAdmin() && !docId.matches('user_secret_.*');
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /packages/{packageId} {
      // Công khai bảng giá cho khách hàng xem và đăng ký
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 4. THÔNG TIN QUÁN (stores)
    // ==========================================
    match /stores/{storeId} {
      // Đọc công khai để tìm kiếm quán theo mã quán (code) lúc đăng nhập
      allow read: if true;

      // Tạo quán: Bắt buộc tạo qua API /api/register-store (Server Admin SDK), cấm client tạo trực tiếp
      allow create: if isSuperAdmin();

      // Cập nhật: Chủ quán chỉ được sửa thông tin chung (tên, địa chỉ...),
      // TUYỆT ĐỐI KHÔNG được tự ý sửa gói cước, trạng thái khóa, hoặc ngày hết hạn (subscription)
      allow update: if isSuperAdmin() || (
        belongsToStore(storeId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription', 'code'])
      );

      // Tuyệt đối không cho phép client xóa quán trực tiếp (Bắt buộc gọi /api/delete-store qua server)
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 5. TÀI KHOẢN NGƯỜI DÙNG (users)
    // ==========================================
    match /users/{userId} {
      // Chỉ xem được danh sách nhân sự thuộc cùng cửa hàng hoặc tài khoản của chính mình.
      allow read: if isSuperAdmin() || (
        isSignedIn() && (
          request.auth.uid == userId ||
          (
            resource == null || (
              resource.data.get('storeId', '') == request.auth.token.get('storeId', '')
            )
          )
        )
      );

      // Tạo và xóa người dùng: BẮT BUỘC qua API /api/save-user và /api/delete-user (Server Admin SDK)
      allow create: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Cập nhật người dùng: Sử dụng WHITELIST nghiêm ngặt (hasOnly).
      allow update: if isSuperAdmin() || (
        isDocumentOfStore() &&
        request.auth.uid == userId &&
        request.resource.data.get('storeId', '') == resource.data.get('storeId', '') &&
        (
          (isStoreManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'displayName', 'phone', 'avatar', 'avatarUrl', 'lastLogin', 'username'])) ||
          (!isStoreManager() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'displayName', 'phone', 'avatar', 'avatarUrl', 'lastLogin']))
        )
      );
    }

    // ==========================================
    // 6. CÁC COLLECTION DỮ LIỆU NỘI BỘ QUÁN (Cách ly 100% theo storeId, tách riêng create/update/delete)
    // ==========================================

    // Báo cáo thống kê siêu tốc (daily_stats): Ghi nhận tự động khi Thu ngân / Quản lý thanh toán
    // Dùng .get('totalRevenue', 0) an toàn cho cả document cũ chưa có trường này
    match /daily_stats/{statId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isCashierOrManager();
      allow update: if isSafeStoreUpdate() && (
        isStoreManager() || (
          isCashierOrManager() &&
          request.resource.data.get('storeId', '') == resource.data.get('storeId', '') &&
          request.resource.data.get('date', '') == resource.data.get('date', '') &&
          request.resource.data.get('totalRevenue', 0) >= resource.data.get('totalRevenue', 0)
        )
      );
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    // Thực đơn (menu): Quản lý toàn quyền; Thu ngân chỉ được cập nhật số lượng tồn kho (stock) khi thanh toán trừ kho
    match /menu/{menuId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isStoreManager();
      allow update: if isSafeStoreUpdate() && (
        isStoreManager() || (
          isCashierOrManager() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        )
      );
      allow delete: if isDocumentOfStore() && isStoreManager();
    }

    // Bàn và nhóm bàn: Nhân viên phục vụ/thu ngân/quản lý cập nhật bàn khi mở/gọi món; Chỉ Quản lý tạo/xóa bàn
    match /tables/{tableId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isStoreManager();
      allow update: if isSafeStoreUpdate();
      allow delete: if isDocumentOfStore() && isStoreManager();
    }

    match /table_groups/{groupId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isStoreManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isDocumentOfStore() && isStoreManager();
    }

    // Hóa đơn bán hàng (invoices): Thu ngân / Quản lý tạo khi thanh toán; Không cho sửa tùy tiện sau khi chốt
    match /invoices/{invoiceId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isCashierOrManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    // Kho và thẻ kho
    match /inventory_logs/{logId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isStoreManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    match /inventory_audits/{auditId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isStoreManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    match /stock_card/{cardId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isCashierOrManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    // Khách hàng & Hội viên: Thu ngân và Quản lý tạo/cập nhật tích điểm
    match /customers/{customerId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isCashierOrManager();
      allow update: if isSafeStoreUpdate() && isCashierOrManager();
      allow delete: if isDocumentOfStore() && isStoreManager();
    }

    // Sổ quỹ (Thu/Chi): Thu ngân tạo phiếu thu khi thanh toán; Sửa/xóa chỉ Quản lý
    match /cash_transactions/{txId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isCashierOrManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    // Cài đặt quán: Quản lý toàn quyền; Thu ngân / Nhân viên gọi món được phép tạo/cập nhật DUY NHẤT danh sách topping hết hàng (outOfStockAddOnIds)
    match /settings/{settingId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && (
        isStoreManager() ||
        (
          isCashierOrManager() &&
          request.resource.data.keys().hasOnly(['storeId', 'outOfStockAddOnIds'])
        )
      );
      allow update: if isSafeStoreUpdate() && (
        isStoreManager() ||
        (
          request.auth.token.get('role', '') in ['cashier', 'order_cashier', 'order'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outOfStockAddOnIds'])
        )
      );
      allow delete: if isDocumentOfStore() && isStoreManager();
    }

    // Chấm công và bảng lương: Nhân viên chỉ được tự chấm công cho chính mình (userId == auth.uid); Quản lý toàn quyền.
    // Dùng .get() kiểm tra checkOutTime an toàn khi check-in và check-out
    match /attendance_records/{attId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      // Khi Check-in: Nhân viên chỉ tạo bản ghi cho chính mình, KHÔNG được điền trước checkOutTime
      allow create: if isWritingDocumentOfStore() && (
        isStoreManager() || (
          request.resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('checkOutTime', null) == null
        )
      );
      // Khi Check-out: Nhân viên chỉ được cập nhật DUY NHẤT checkOutTime và locationValid trên bản ghi của mình,
      // KHÔNG ĐƯỢC sửa date, checkInTime, userId, và chỉ được check-out 1 lần duy nhất (checkOutTime == null)
      allow update: if isSafeStoreUpdate() && (
        isStoreManager() || (
          resource.data.get('userId', '') == request.auth.uid &&
          request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
          request.resource.data.get('date', '') == resource.data.get('date', '') &&
          request.resource.data.get('checkInTime', '') == resource.data.get('checkInTime', '') &&
          resource.data.get('checkOutTime', null) == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOutTime', 'locationValid'])
        )
      );
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    match /payroll_records/{payrollId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isStoreManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    // Ca làm việc: Quản lý toàn quyền; Thu ngân và Order mở/đóng ca của CHÍNH MÌNH (chống thu ngân sửa ca người khác)
    // Dùng .get('staffId', '') kiểm tra an toàn
    match /shifts/{shiftId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      // Tạo ca: Quản lý quán, hoặc Thu ngân / Order mở ca cho chính mình
      allow create: if isWritingDocumentOfStore() && (
        isStoreManager() ||
        request.resource.data.get('staffId', '') == request.auth.uid
      );
      // Cập nhật ca: Quản lý toàn quyền; Thu ngân và Order chỉ được sửa ca của CHÍNH MÌNH (chống thu ngân sửa ca người khác)
      allow update: if isSafeStoreUpdate() && (
        isStoreManager() || (
          resource.data.get('staffId', '') == request.auth.uid &&
          request.resource.data.get('staffId', '') == resource.data.get('staffId', '') &&
          (
            request.auth.token.get('role', '') in ['cashier', 'order_cashier'] ||
            (request.auth.token.get('role', '') == 'order' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalRevenue', 'totalCash']))
          )
        )
      );
      allow delete: if isSuperAdmin() || (isDocumentOfStore() && isStoreManager());
    }

    // Hóa đơn đã hủy
    match /cancelled_invoices/{cancelId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore() && isCashierOrManager();
      allow update: if isSafeStoreUpdate() && isStoreManager();
      allow delete: if isSuperAdmin();
    }

    // Khóa thanh toán và khóa chấm công tránh trùng đơn
    match /checkout_locks/{lockId} {
      allow read: if isSuperAdmin() || (
        isSignedIn() && (resource == null || resource.data.get('storeId', '') == request.auth.token.get('storeId', ''))
      );
      allow create: if isWritingDocumentOfStore();
      allow update: if isSafeStoreUpdate();
      allow delete: if isDocumentOfStore();
    }
  }
}
