rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 0. CÁC HÀM BẢO MẬT & KIỂM TRA PHÂN QUYỀN
    // ==========================================
    
    // Kiểm tra danh tính Quản trị viên tối cao (SuperAdmin)
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'superadmin' ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.uid == 'superadmin'
      );
    }

    // Kiểm tra danh tính Quản lý (Admin của quán hoặc SuperAdmin)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role in ['admin', 'superadmin'] ||
        request.auth.token.isSuperAdmin == true ||
        request.auth.uid == 'superadmin'
      );
    }

    // Kiểm tra thông tin thanh toán mã QR (VietQR / STK Ngân hàng) KHÔNG BỊ THAY ĐỔI
    // Ngăn chặn nhân viên thường hoặc kẻ gian sửa STK nhận tiền của quán
    function isBankInfoUnchanged() {
      return (
        // STK ngân hàng: Nếu đã có thì phải giữ nguyên như cũ, nếu chưa có thì không được tự thêm mới
        (!('bankAccountNumber' in resource.data) && !('bankAccountNumber' in request.resource.data) || ('bankAccountNumber' in resource.data && request.resource.data.bankAccountNumber == resource.data.bankAccountNumber))
        // Tên chủ tài khoản: Phải giữ nguyên như cũ
        && (!('bankAccountName' in resource.data) && !('bankAccountName' in request.resource.data) || ('bankAccountName' in resource.data && request.resource.data.bankAccountName == resource.data.bankAccountName))
        // Mã ngân hàng: Phải giữ nguyên như cũ
        && (!('bankCode' in resource.data) && !('bankCode' in request.resource.data) || ('bankCode' in resource.data && request.resource.data.bankCode == resource.data.bankCode))
      );
    }

    // ==========================================
    // 1. VÙNG BẢO MẬT TỐI MẬT (Chỉ Admin SDK Server)
    // Client tuyệt đối KHÔNG THỂ đọc hay ghi trực tiếp
    // ==========================================
    match /user_secrets/{userId} {
      allow read, write: if false;
    }

    match /processed_transactions/{txId} {
      allow read, write: if false;
    }

    // ==========================================
    // 2. CÀI ĐẶT HỆ THỐNG VÀ GÓI CƯỚC (BẢO VỆ SUPERADMIN)
    // Đọc công khai cho toàn bộ client cũ/mới, nhưng CHỈ SUPERADMIN MỚI ĐƯỢC GHI
    // ==========================================
    match /system/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 3. THÔNG TIN QUÁN VÀ TÀI KHOẢN NGƯỜI DÙNG
    // Khóa chặt Superadmin, bảo toàn tài khoản của quán
    // ==========================================
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.resource.data.code is string;
      allow update: if true;
      allow delete: if isSuperAdmin(); // Không cho tự ý xóa cửa hàng từ client
    }

    match /users/{userId} {
      allow read: if true;
      
      // CẤM tạo tài khoản mạo danh superadmin từ client
      allow create: if userId != 'superadmin'
                    && request.resource.data.username != 'superadmin'
                    && request.resource.data.storeId is string
                    && request.resource.data.username is string
                    && request.resource.data.role in ['admin', 'manager', 'cashier', 'order', 'order_cashier', 'kitchen'];
      
      // TUYỆT ĐỐI CẤM XÓA tài khoản superadmin
      allow delete: if userId != 'superadmin'
                    && resource.data.role != 'superadmin'
                    && resource.data.username != 'superadmin';

      // Tài khoản superadmin chỉ chính Superadmin mới được sửa; nhân sự quán bảo toàn role/storeId
      allow update: if (userId == 'superadmin' || resource.data.role == 'superadmin' || resource.data.username == 'superadmin')
                      ? isSuperAdmin()
                      : (request.resource.data.role == resource.data.role
                         && request.resource.data.storeId == resource.data.storeId
                         && request.resource.data.username == resource.data.username
                         && (!('password' in request.resource.data) || request.resource.data.password == resource.data.password)
                         && (!('isLegacy' in request.resource.data) || request.resource.data.isLegacy == resource.data.isLegacy));
    }

    // ==========================================
    // 4. CÀI ĐẶT CỦA CỬA HÀNG (BẢO VỆ MÃ QR / TÀI KHOẢN NGÂN HÀNG)
    // Chỉ Admin mới được cài/sửa mã QR; nhân viên khác không được thay thế
    // ==========================================
    match /settings/{settingId} {
      allow read: if true;
      allow delete: if isAdmin();
      
      // Khi tạo mới: Admin được set mọi trường; nếu không phải Admin thì cấm gán trường ngân hàng
      allow create: if isAdmin() 
                    || (!('bankAccountNumber' in request.resource.data) && !('bankCode' in request.resource.data));
      
      // Khi cập nhật: Admin được đổi STK; nhân viên thường chỉ được cập nhật các mục khác (không đổi STK)
      allow update: if isAdmin() || isBankInfoUnchanged();
    }

    // ==========================================
    // 5. DỮ LIỆU TỔNG HỢP BÁO CÁO
    // ==========================================
    match /daily_stats/{statId} {
      allow read, write: if true;
    }

    // ==========================================
    // 6. DỮ LIỆU VẬN HÀNH BÁN HÀNG CỦA QUÁN
    // (Thực đơn, Bàn, Hóa đơn, Kho, Sổ quỹ, Ca làm việc...)
    // Tương thích 100% cho mọi máy iPhone / iPad đang chạy bản cũ
    // ==========================================
    match /menu/{menuId} {
      allow read, write: if true;
    }

    match /tables/{tableId} {
      allow read, write: if true;
    }

    match /table_groups/{groupId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /inventory_logs/{logId} {
      allow read, write: if true;
    }

    match /inventory_audits/{auditId} {
      allow read, write: if true;
    }

    match /stock_card/{cardId} {
      allow read, write: if true;
    }

    match /customers/{customerId} {
      allow read, write: if true;
    }

    match /cash_transactions/{txId} {
      allow read, write: if true;
    }

    match /attendance_records/{attId} {
      allow read, write: if true;
    }

    match /payroll_records/{payrollId} {
      allow read, write: if true;
    }

    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    match /cancelled_invoices/{cancelId} {
      allow read, write: if true;
    }

    match /checkout_locks/{lockId} {
      allow read, write: if true;
    }
  }
}